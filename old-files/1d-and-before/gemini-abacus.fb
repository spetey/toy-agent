# F***brain Reflective v1 state - Abacus Node
# by Gemini for `fb_reflect_v2.py`
#
tape_size=32
ip=3
dir=1
cl=0
h0=0
h1=1
step=0
# tape[0] is our Abacus Box. Set to 3.
# tape[2] is just a spacer.
# tape[3] is the entry point (moving right).
# tape[4] is the MIRROR (/ = opcode 12).
# tape[5] is the DECREMENT path (reflects here if >0).
# tape[6] is the EMPTY path (passes here if 0).
tape=3,0,0,0,12,8,99